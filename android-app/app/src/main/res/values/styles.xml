<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/protec_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/protec_background</item>
        <item name="android:statusBarColor">@color/protec_bar</item>
        <item name="android:navigationBarColor">@color/protec_bar</item>
        <item name="android:windowAnimationStyle">@style/ProtecWindowAnim</item>
    </style>
    <style name="ProtecWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/protec_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/protec_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/protec_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/protec_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/protec_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/protec_hold</item>
        <item name="android:taskCloseEnterAnimation">@anim/protec_hold</item>
        <item name="android:taskCloseExitAnimation">@anim/protec_exit</item>
    </style>
</resources>
